# Anthropic API Key
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT Secret Key (本番環境では必ずランダムな値に変更)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# PostgreSQL 接続文字列。未設定時はローカル SQLite を使用
# DATABASE_URL=postgresql://user:password@host/dbname

# CORS許可オリジン（カンマ区切り）。未設定時は localhost + デフォルト本番URL
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
